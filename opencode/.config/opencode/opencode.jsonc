{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-5.4",
  "agents": {
    "title": {
      "model": "github-copilot/claude-haiku-4-5"
    }
  },
  "update": "disable",
  "share": "disabled",
  "skills": ["{env:HOME}/.local/share/opencode-azure-skills"],
  "mcp": {
    "servers": {
      "azure": {
        "type": "local",
        "command": ["npx", "-y", "@azure/mcp@latest", "server", "start"],
        "disabled": false
      }
    }
  },
  "lsp": {
    "fsharp": {
      "command": ["fsautocomplete", "--background-service-enabled"],
      "extensions": [".fs", ".fsx", ".fsi", ".fsproj"],
      "initialization": {
        "AutomaticWorkspaceInit": true
      }
    }
  }
}
