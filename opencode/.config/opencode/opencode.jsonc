{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-6.1-sol",
  "agents": {
    "title": {
      "model": "github-copilot/claude-haiku-4-5"
    }
  },
  "update": "disable",
  "share": "disabled",
  "permissions": [
    { "action": "confluence_*", "resource": "*", "effect": "deny" },
    { "action": "confluence_confluence_search_pages", "resource": "*", "effect": "allow" },
    { "action": "confluence_confluence_get_page_metadata", "resource": "*", "effect": "allow" },
    { "action": "confluence_confluence_get_page", "resource": "*", "effect": "allow" },
    { "action": "confluence_confluence_get_children", "resource": "*", "effect": "allow" },
    { "action": "confluence_confluence_list_attachments", "resource": "*", "effect": "allow" },
    { "action": "confluence_confluence_get_attachment_image", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "/home/wote/.local/share/opencode/secrets/*", "effect": "deny" }
  ],
  "skills": [
    "{env:HOME}/.local/share/opencode-azure-skills",
    "/home/wote/work/claims-architecture-gh-copilot-toolkit/framework/skills"
  ],
  "mcp": {
    "servers": {
      "azure": {
        "type": "local",
        "command": ["npx", "-y", "@azure/mcp@latest", "server", "start"],
        "environment": {
          "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT": "1"
        },
        "disabled": false
      },
      "browse": {
        "type": "local",
        "command": ["browse", "mcp"],
        "environment": {
          "OPENCODE_BROWSER_AUTO_UPDATE": "notify"
        },
        "disabled": false
      },
      "confluence": {
        "type": "local",
        "command": [
          "/home/wote/.nix-profile/bin/dotnet",
          "/home/wote/.local/share/opencode/cat/confluence/ConfluenceMcp.dll"
        ],
        "environment": {
          "CONFLUENCE_URL": "https://confluence.ifint.biz/",
          "CONFLUENCE_TOKEN": "{file:~/.local/share/opencode/secrets/confluence-token}"
        }
      },
      "knowledge-cache": {
        "type": "local",
        "command": [
          "/home/wote/.nix-profile/bin/dotnet",
          "/home/wote/.local/share/opencode/cat/knowledge-cache/KnowledgeCacheMcp.dll"
        ],
        "environment": {
          "CAT_HOME": "/home/wote/.cat"
        }
      }
    }
  },
  "lsp": {
    "fsharp": {
      "command": ["fsautocomplete", "--background-service-enabled"],
      "extensions": [".fs", ".fsx", ".fsi", ".fsproj"],
      "initialization": {
        "AutomaticWorkspaceInit": true
      }
    }
  }
}
